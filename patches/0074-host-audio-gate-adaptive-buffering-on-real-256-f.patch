From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: LNPANDY <lnp-andy@hotmail.com>
Date: Sun, 22 Nov 2026 05:58:33 +0800
Subject: [PATCH] host/audio: gate adaptive buffering on real >256-frame
 callbacks under DM_AUDIO_MIX

When DM_AUDIO_MIX=1 is enabled on iOS while no other app holds the audio route open, AVAudioSession still delivers 48 kHz 5 ms (240-frame) callbacks. Previously both front_ios.m and hle_audio.c forced a synthetic 1024-frame hint whenever DM_AUDIO_MIX=1, pre-opening target_bytes and holding early buffer release active even at 240 frames. That inflated the AudioOut queue to ~13 blocks and drained streaming BGM and voice decoders in OpenAudioOut games such as Pokemon Pokopia while memory-resident SFX stayed normal.

Stop clamping io_frames and eff_frames to 1024 or blocking small_cb_streak backoff solely because DM_AUDIO_MIX=1 is set. Activate adaptive target_bytes only when the real I/O buffer hint or callback frame count exceeds AU_LARGE_CB_THRESHOLD_FRAMES (256), and allow backoff to zero once callbacks settle back to 5 ms.

Upstream-Status: fork-only
Reason: Keep DM_AUDIO_MIX=1 at normal 5 ms AudioOut pacing unless real callbacks exceed 256 frames
Issue: LNPANDY/NX2Apple#1269

---
 dm/host/hle_audio.c           | 13 ++-------
 dm/host/tests/t_audio_stats.c | 55 +++++++++++++++++++++++++----------
 dm/ios/Sources/front_ios.m    |  5 ++--
 3 files changed, 45 insertions(+), 28 deletions(-)

diff --git a/dm/host/hle_audio.c b/dm/host/hle_audio.c
index 9ffb6a9..cc1e285 100644
--- a/dm/host/hle_audio.c
+++ b/dm/host/hle_audio.c
@@ -37,11 +37,10 @@ typedef struct {
     aout_buf owned_buf[OWNED_N];
     _Atomic uint8_t owned_busy[OWNED_N];
     _Atomic uint64_t queued_bytes;     // Unplayed PCM bytes currently queued across q[]
-    _Atomic uint64_t target_bytes;     // Adaptive in-flight target (>0 only when callback frames > AU_LARGE_CB_THRESHOLD_FRAMES or DM_AUDIO_MIX is active)
+    _Atomic uint64_t target_bytes;     // Adaptive in-flight target (>0 only when real callback frames exceed AU_LARGE_CB_THRESHOLD_FRAMES)
     _Atomic uint32_t guest_in_q;       // Unreleased guest buffers currently sitting in q[]
     uint64_t prebuf_need;              // Guest bytes required before draining after target_bytes expands (consumer-only)
     unsigned prebuf_holds, small_cb_streak;
-    _Atomic int env_mix;
     uint64_t pos;                      // Bytes already played of the current block
     AudioUnit au;
     int start_phase, reset_pending, mute;   // a reset during start replaces the unit after the call returns
@@ -97,12 +96,8 @@ static uint64_t au_target_bytes(int ch, uint32_t cb_frames) {
     return (uint64_t)want * (uint64_t)ch * sizeof(int16_t);
 }
 static void au_sync_mix_hint(aout *a) {
-    const char *mix_e = getenv("DM_AUDIO_MIX");
-    int env_mix = mix_e && atoi(mix_e) != 0;
-    atomic_store_explicit(&a->env_mix, env_mix, memory_order_release);
     uint32_t hint = atomic_load_explicit(&g_io_buffer_hint_frames, memory_order_acquire);
     if (hint <= AU_LARGE_CB_THRESHOLD_FRAMES) hint = 0u;
-    if (env_mix && hint < 1024u) hint = 1024u;
     uint64_t init_target = au_target_bytes(a->ch, hint);
     if (init_target > atomic_load_explicit(&a->target_bytes, memory_order_relaxed))
         atomic_store_explicit(&a->target_bytes, init_target, memory_order_release);
@@ -309,10 +304,8 @@ static OSStatus au_render(void *ctx, AudioUnitRenderActionFlags *f, const AudioT
         memset(bl->mBuffers[0].mData, 0, bl->mBuffers[0].mDataByteSize);
     } else {
         uint32_t eff_frames = frames;
-        int env_mix = atomic_load_explicit(&a->env_mix, memory_order_acquire);
         uint32_t hint = atomic_load_explicit(&g_io_buffer_hint_frames, memory_order_acquire);
         if (hint <= AU_LARGE_CB_THRESHOLD_FRAMES) hint = 0u;
-        if (env_mix && eff_frames < 1024u) eff_frames = 1024u;
         if (hint > eff_frames) eff_frames = hint;
         uint64_t want_target = au_target_bytes(a->ch, eff_frames);
         uint64_t cur_target = atomic_load_explicit(&a->target_bytes, memory_order_acquire);
@@ -321,7 +314,7 @@ static OSStatus au_render(void *ctx, AudioUnitRenderActionFlags *f, const AudioT
             a->small_cb_streak = 0;
             uint64_t req_bytes = (uint64_t)frames * (uint64_t)a->ch * sizeof(int16_t);
             if (req_bytes > a->prebuf_need) { a->prebuf_need = req_bytes; a->prebuf_holds = 0; }
-        } else if (frames <= AU_LARGE_CB_THRESHOLD_FRAMES && !env_mix && !hint && cur_target && ++a->small_cb_streak >= 64) {
+        } else if (frames <= AU_LARGE_CB_THRESHOLD_FRAMES && !hint && cur_target && ++a->small_cb_streak >= 64) {
             atomic_compare_exchange_strong_explicit(&a->target_bytes, &cur_target, 0, memory_order_acq_rel, memory_order_relaxed);
             a->small_cb_streak = 0;
         }
@@ -750,7 +743,7 @@ static Result au_open_impl(void *g, void *ev, const char *name, const uint8_t *p
     atomic_init(&a->state, STATE_STOPPED); atomic_init(&a->vol, 0x3f800000u);
     atomic_init(&a->q_head, 0); atomic_init(&a->q_tail, 0);
     atomic_init(&a->rel_head, 0); atomic_init(&a->rel_tail, 0);
-    atomic_init(&a->queued_bytes, 0); atomic_init(&a->target_bytes, 0); atomic_init(&a->guest_in_q, 0); atomic_init(&a->env_mix, 0);
+    atomic_init(&a->queued_bytes, 0); atomic_init(&a->target_bytes, 0); atomic_init(&a->guest_in_q, 0);
     au_sync_mix_hint(a);
     atomic_init(&a->null_run, 0); atomic_init(&a->notify_run, 1);
     atomic_init(&a->notify_pending, 0); atomic_init(&a->notify_armed, 0);
diff --git a/dm/host/tests/t_audio_stats.c b/dm/host/tests/t_audio_stats.c
index c145d9d..cb7939a 100644
--- a/dm/host/tests/t_audio_stats.c
+++ b/dm/host/tests/t_audio_stats.c
@@ -134,6 +134,7 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
         requested_total += frames;
         if (frames == 241) saw_241 = 1;
 
+        unsigned prev_prebuf_holds = a->prebuf_holds;
         memset(played, 0, (size_t)frames * 4);
         AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
         in_callback = 1;
@@ -142,18 +143,25 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
         atomic_store(&a->st_pending, 0);
         if (atomic_load(&a->target_bytes) != 0) target_opened++;
         if (a->early_tail != 0) early_used++;
-        if (a->prebuf_holds != 0) prebuf_held++;
+        int held_this_cb = a->prebuf_holds > prev_prebuf_holds;
+        if (held_this_cb) prebuf_held++;
 
-        unsigned j = 0;
-        if (!started_stream) {
-            while (j < frames && played[2 * j] == 0 && played[2 * j + 1] == 0) j++;
-            if (j < frames) started_stream = 1;
-        }
-        for (; j < frames; j++) {
-            int16_t exp_l = stream_sample(consumed, 0);
-            int16_t exp_r = stream_sample(consumed, 1);
-            if (played[2 * j] != exp_l || played[2 * j + 1] != exp_r) mismatches++;
-            consumed++;
+        if (held_this_cb) {
+            for (unsigned j = 0; j < frames; j++) {
+                if (played[2 * j] != 0 || played[2 * j + 1] != 0) mismatches++;
+            }
+        } else {
+            unsigned j = 0;
+            if (!started_stream) {
+                while (j < frames && played[2 * j] == 0 && played[2 * j + 1] == 0) j++;
+                if (j < frames) started_stream = 1;
+            }
+            for (; j < frames; j++) {
+                int16_t exp_l = stream_sample(consumed, 0);
+                int16_t exp_r = stream_sample(consumed, 1);
+                if (played[2 * j] != exp_l || played[2 * j + 1] != exp_r) mismatches++;
+                consumed++;
+            }
         }
 
         while ((rel = h_au_Released(out)) != NULL) {
@@ -175,7 +183,7 @@ static void replay_callback_regime(const char *label, int ch, unsigned nbufs, un
               "5 ms / 44.1 kHz resample callbacks never activate target_bytes or early release");
         CHECK(consumed == requested_total, "5 ms / 44.1 kHz mode plays from sample 0 with zero prebuffer gaps");
     } else {
-        CHECK(atomic_load(&a->target_bytes) > 0, "large-callback or DM_AUDIO_MIX regime activates adaptive target_bytes");
+        CHECK(atomic_load(&a->target_bytes) > 0, "large-callback regime activates adaptive target_bytes");
     }
 
     // Stop must return every guest buffer exactly once so guest middleware can join cleanly.
@@ -210,7 +218,7 @@ static void test_adaptive_threshold_and_backoff(void) {
     dm_audio_io_buffer_hint(0);
     CHECK(atomic_load(&g_io_buffer_hint_frames) == 0, "clearing buffer hint resets global hint");
 
-    int16_t played[512 * 2] = {0};
+    int16_t played[1024 * 2] = {0};
     for (unsigned i = 0; i < 64; i++) {
         unsigned frames = (i & 1) ? 241u : 240u;
         AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
@@ -246,7 +254,7 @@ static void test_adaptive_threshold_and_backoff(void) {
     a = ao(out);
     a->dev_ch = 2;
     atomic_store(&a->state, STATE_STARTED);
-    CHECK(atomic_load(&a->target_bytes) > 0, "DM_AUDIO_MIX=1 pre-opens target_bytes at open");
+    CHECK(atomic_load(&a->target_bytes) == 0, "DM_AUDIO_MIX=1 does not pre-open target_bytes when I/O buffer is 5 ms");
     for (unsigned i = 0; i < 70; i++) {
         unsigned frames = (i & 1) ? 241u : 240u;
         AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
@@ -255,14 +263,31 @@ static void test_adaptive_threshold_and_backoff(void) {
         in_callback = 0;
         atomic_store(&a->st_pending, 0);
     }
-    CHECK(atomic_load(&a->target_bytes) > 0, "DM_AUDIO_MIX=1 keeps target_bytes active across 240-241 frame callbacks");
+    CHECK(atomic_load(&a->target_bytes) == 0, "DM_AUDIO_MIX=1 keeps target_bytes inactive across 240-241 frame callbacks");
+    AudioBufferList bl1024 = {.mNumberBuffers = 1, .mBuffers = {{2, 1024u * 4u, played}}};
+    in_callback = 1;
+    au_render(a, NULL, NULL, 0, 1024, &bl1024);
+    in_callback = 0;
+    atomic_store(&a->st_pending, 0);
+    CHECK(atomic_load(&a->target_bytes) > 0, "DM_AUDIO_MIX=1 activates target_bytes on real 1024-frame callbacks");
+    for (unsigned i = 0; i < 64; i++) {
+        unsigned frames = (i & 1) ? 241u : 240u;
+        AudioBufferList bl = {.mNumberBuffers = 1, .mBuffers = {{2, frames * 4, played}}};
+        in_callback = 1;
+        au_render(a, NULL, NULL, 0, frames, &bl);
+        in_callback = 0;
+        atomic_store(&a->st_pending, 0);
+    }
+    CHECK(atomic_load(&a->target_bytes) == 0, "DM_AUDIO_MIX=1 settles target_bytes back to zero once callbacks return to 5 ms");
     h_au_Close(out);
     unsetenv("DM_AUDIO_MIX");
 }
 int main(void) {
     setenv("DM_AUDIO", "0", 1); setenv("DM_AUDIO_MUTE", "0", 1);
     replay_callback_regime("exclusive-240", 2, 4, 240, 0, 0);
+    replay_callback_regime("ios-mix-240", 2, 4, 240, 0, 1);
     replay_callback_regime("mac-44k-5ms-240-241", 2, 4, 240, 5, 0);
+    replay_callback_regime("ios-mix-44k-5ms-240-241", 2, 4, 240, 5, 1);
     replay_callback_regime("unhinted-512", 2, 4, 240, 6, 0);
     replay_callback_regime("ios-mix-1024", 2, 4, 240, 1, 1);
     replay_callback_regime("ios-mix-variable-240-1024", 2, 4, 240, 2, 1);
diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index 607ebc3..37f8cbf 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -631,9 +631,8 @@ void front_ios_audio_session(void) {
     g_session_off = ![s setActive:YES error:&e];
     if (g_session_off) LOG("[RED] audio session activation failed: %s", e.localizedDescription.UTF8String);
     unsigned io_frames = s.IOBufferDuration > 0 ? (unsigned)(s.IOBufferDuration * 48000.0 + 0.5) : 0;
-    if (mix_on && io_frames < 1024u) io_frames = 1024u;
-    // Match hle_audio.c AU_LARGE_CB_THRESHOLD_FRAMES (256) so 44.1 kHz ~5 ms buffers do not trip adaptive staging.
-    dm_audio_io_buffer_hint((mix_on || io_frames > 256u) ? io_frames : 0u);
+    // Match hle_audio.c AU_LARGE_CB_THRESHOLD_FRAMES (256) so DM_AUDIO_MIX=1 only stages when the real I/O buffer exceeds 256 frames.
+    dm_audio_io_buffer_hint(io_frames > 256u ? io_frames : 0u);
     LOG("audio session: sample rate %.0f Hz, I/O buffer %.2f ms (asked for 5 ms), mix %s", s.sampleRate, s.IOBufferDuration * 1000, mix_on ? "on" : "off");
     front_ios_audio_channels(s);
 }
